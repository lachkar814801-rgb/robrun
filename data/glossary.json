  "ui.intro.home": { "en": "A fan database for ROB RUN: weapons, items, vehicles, upgrades and the map. Community data, local images, prices in USD.", "fr": "Une base de données de fans pour ROB RUN : armes, objets, véhicules, upgrades et carte. Données communautaires, images locales, prix en USD.", "ar": "قاعدة بيانات من إعداد المعجبين للعبة ROB RUN: أسلحة، عناصر، مركبات، ترقيات وخريطة. بيانات مجتمعية، صور محلية، وأسعار بالدولار الأمريكي." },
  "ui.intro.weapons": { "en": "The 46 weapons in the game, grouped by family and Mk variant. Stats come from community data; missing values are shown as not available.", "fr": "Les 46 armes du jeu, regroupées par famille et déclinaison Mk. Les statistiques viennent de données communautaires ; les valeurs absentes sont indiquées « non disponible ».", "ar": "أسلحة اللعبة الـ46 مرتبة حسب العائلة والنسخة Mk. الإحصائيات من بيانات المجتمع، والقيم الغائبة تظهر كغير متوفرة." },
  "ui.intro.items": { "en": "All 563 items with prices in USD, rarities and categories. Items that cannot be sold are clearly marked.", "fr": "Les 563 objets avec leurs prix en USD, raretés et catégories. Les objets non vendables sont clairement indiqués.", "ar": "العناصر الـ563 مع الأسعار بالدولار الأمريكي والندرة والفئات. العناصر غير القابلة للبيع تظهر بوضوح." },
  "ui.intro.vehicles": { "en": "The vehicles present in the current dataset. Detailed performance stats are not available yet.", "fr": "Les véhicules présents dans les données actuelles. Les caractéristiques détaillées ne sont pas encore disponibles.", "ar": "المركبات الموجودة في البيانات الحالية. الخصائص التفصيلية غير متوفرة بعد." },
  "ui.intro.upgrades": { "en": "Vehicle upgrades and workbench upgrades found in the current dataset.", "fr": "Les upgrades de véhicules et d’établis présents dans les données actuelles.", "ar": "تحسينات المركبات وطاولات العمل الموجودة في البيانات الحالية." },
  "ui.intro.database": { "en": "A unified search across weapons, items and map points. Coordinates and loot links will arrive with the map (P6).", "fr": "Une recherche unifiée dans les armes, les objets et les points de carte. Les coordonnées et les liens de loot arriveront avec la carte (P6).", "ar": "بحث موحد في الأسلحة والعناصر ونقاط الخريطة. الإحداثيات وروابط الغنائم ستصل مع الخريطة (P6)." },
